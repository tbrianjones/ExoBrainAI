# ExoBrain Configuration
# Copy this file to .env and customize

# USER: default user data
EXOBRAIN_USER="T. Brian Jones"
EXOBRAIN_USER_EMAIL="tbrianjones@gmail.com"

# REQUIRED: Path to your canonical data directory (Dropbox, iCloud, or local)
# This folder contains your source-of-truth content:
#   raw/      - Your documents (UUIDv7.md files)
#   overlay/  - Your annotations (JSONL)
EXOBRAIN_DATA_DIR=/Users/you/Dropbox/ExoBrain

# OPTIONAL: Path to cache/derived data (default: container volume)
# This folder contains regenerable artifacts:
#   staged/   - Merged docs for indexing
#   graphrag/ - Index artifacts (parquet files)
#   logs/     - Application logs
# Leave unset to use container-internal volume (recommended)
# EXOBRAIN_CACHE_DIR=/path/to/local/cache

# API server port (default: 8420)
EXOBRAIN_API_PORT=8420

# Ollama port (default: 11434)
OLLAMA_PORT=11434

# Model configuration (defaults work for M2 Pro 16GB)
EXOBRAIN_LLM_MODEL=llama3.1:8b
EXOBRAIN_EMBED_MODEL=nomic-embed-text

# Overlay aggregation window in days (default: 30)
EXOBRAIN_OVERLAY_WINDOW_DAYS=30

# Watcher debounce delay in seconds (default: 2)
EXOBRAIN_WATCHER_DEBOUNCE_SECONDS=2
