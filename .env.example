# ExoBrain Configuration
# Copy this file to .env and customize

# REQUIRED: Path to your data directory (Dropbox, iCloud, or local)
# This folder will contain: raw/, overlay/, staged/, graphrag/, logs/
EXOBRAIN_DATA_DIR=/Users/you/Dropbox/ExoBrain

# API server port (default: 8420)
EXOBRAIN_API_PORT=8420

# Ollama port (default: 11434)
OLLAMA_PORT=11434

# Model configuration (defaults work for M2 Pro 16GB)
EXOBRAIN_LLM_MODEL=llama3.1:8b
EXOBRAIN_EMBED_MODEL=nomic-embed-text

# Overlay aggregation window in days (default: 30)
EXOBRAIN_OVERLAY_WINDOW_DAYS=30

# Watcher debounce delay in seconds (default: 2)
EXOBRAIN_WATCHER_DEBOUNCE_SECONDS=2
