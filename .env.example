# ExoBrain Configuration
# Copy this file to .env and customize

# USER: default user data
EXOBRAIN_USER="user name"
EXOBRAIN_USER_EMAIL="user@email.com"

# REQUIRED: Path to your canonical data directory (Dropbox, iCloud, or local)
# This folder contains your source-of-truth content:
#   raw/      - Your documents (UUIDv7.md files)
#   overlay/  - Your annotations (JSONL)
EXOBRAIN_DATA_DIR=/Users/tbj/Library/CloudStorage/Dropbox/tbj-exobrain # TBJ's native location. Automatically backs up to Dropbox.

# OPTIONAL: Path to test data directory (default: ./test-data in repo root)
# Used by `docker compose --profile test` for isolated integration testing
# EXOBRAIN_TEST_DATA_DIR=./test-data
# EXOBRAIN_TEST_API_PORT=8421

# OPTIONAL: Path to cache/derived data (default: container volume)
# This folder contains regenerable artifacts:
#   staged/   - Merged docs for indexing
#   graphrag/ - Index artifacts (parquet files)
#   logs/     - Application logs
# Leave unset to use container-internal volume (recommended)
# EXOBRAIN_CACHE_DIR=/path/to/local/cache

# API server port (default: 8420)
EXOBRAIN_API_PORT=8420

# Ollama deployment mode
# - native: Run Ollama directly on Mac (RECOMMENDED; uses GPU, 20-30x faster)
# - docker: Run Ollama in Docker container (CPU only, very slow on Mac)
#
# If using native mode, run: ./scripts/setup-native-ollama.sh
OLLAMA_MODE=native

# LLM Model Selection
#
# GraphRAG needs a capable model for entity extraction and community reports.
# Larger models produce better results but use more memory and are slower.
#
# Recommended options (pick one):
#
#   llama3.1:8b     ; RECOMMENDED. Best balance of quality and speed.
#                     ~5GB download, ~7GB RAM. Works well on 16GB Macs.
#
#   llama3.3:70b    ; Highest quality. Only if you have 64GB+ RAM or
#                     offload to GPU. Much slower but excellent results.
#
#   llama3.2:3b     ; Fast but lower quality. Use only for testing or
#                     if you have <8GB RAM. May produce incomplete extractions.
#
#   mistral:7b      ; Alternative to llama3.1:8b. Similar quality and speed.
#
#   phi3:medium     ; Microsoft's model. Good quality, smaller than 8B.
#                     ~8GB RAM. Worth trying if llama3.1 is too slow.
#
EXOBRAIN_LLM_MODEL=llama3.1:8b

# Embedding Model
#
# Used for vector similarity search. nomic-embed-text is the standard choice.
#
#   nomic-embed-text  ; RECOMMENDED. Good quality, fast, ~300MB.
#   mxbai-embed-large ; Higher quality embeddings, ~700MB.
#
EXOBRAIN_EMBED_MODEL=nomic-embed-text

# Overlay aggregation window in days (default: 30)
EXOBRAIN_OVERLAY_WINDOW_DAYS=30

# Watcher debounce delay in seconds (default: 2)
EXOBRAIN_WATCHER_DEBOUNCE_SECONDS=2
